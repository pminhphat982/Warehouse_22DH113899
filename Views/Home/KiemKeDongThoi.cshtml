@{
    ViewBag.Title = "Kiểm kê đồng thời";
}

<h2>Kiểm kê đồng thời 2 sản phẩm</h2>

@* Khu vực hiện thông báo lỗi *@
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" style="color: red; font-weight: bold; border: 1px solid red; padding: 15px; margin-bottom: 20px;">
        @TempData["Error"]
    </div>
}

<div class="well" style="background-color: #f8f9fa; padding: 20px; border-radius: 8px;">
    @using (Html.BeginForm("KiemKeDongThoi", "Home", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="row">
            <!-- SẢN PHẨM 1 -->
            <div class="col-md-6" style="border-right: 2px dashed #ccc;">
                <h4 style="color: #2980b9;">Sản phẩm 1</h4>
                <div class="form-group">
                    <label>Chọn sản phẩm:</label>
                    @Html.DropDownList("id1", ViewBag.ProductList as SelectList, "-- Chọn sản phẩm 1 --", new { @class = "form-control", required = "required" })
                </div>
                <div class="form-group">
                    <label>Số lượng thực tế mới:</label>
                    <input type="number" name="qty1" class="form-control" required />
                </div>
            </div>

            <!-- SẢN PHẨM 2 -->
            <div class="col-md-6">
                <h4 style="color: #27ae60;">Sản phẩm 2</h4>
                <div class="form-group">
                    <label>Chọn sản phẩm:</label>
                    @Html.DropDownList("id2", ViewBag.ProductList as SelectList, "-- Chọn sản phẩm 2 --", new { @class = "form-control", required = "required" })
                </div>
                <div class="form-group">
                    <label>Số lượng thực tế mới:</label>
                    <input type="number" name="qty2" class="form-control" required />
                </div>
            </div>
        </div>

        <hr />
        <div class="text-center">
            <button type="submit" class="btn btn-primary btn-lg">Xác nhận cập nhật cả hai</button>
        </div>
    }
</div>