@model Warehouse.Models.Product

<h2>Thêm Sản Phẩm Mới</h2>

@using (Html.BeginForm("Create", "Home", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="well" style="background-color: #fff; padding: 25px; border-radius: 8px; border: 1px solid #ddd; max-width: 600px;">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group" style="margin-bottom: 15px;">
            <label style="font-weight: bold;">Tên sản phẩm <span style="color:red">*</span></label>
            @Html.EditorFor(model => model.ProductName, new { htmlAttributes = new { @class = "form-control", placeholder = "Ví dụ: Bàn phím cơ..." } })
            @Html.ValidationMessageFor(model => model.ProductName, "", new { @class = "text-danger", style = "color:red; font-style: italic;" })
        </div>

        <div class="form-group" style="margin-bottom: 15px;">
            <label style="font-weight: bold;">Danh mục <span style="color:red">*</span></label>
            @Html.EditorFor(model => model.Category, new { htmlAttributes = new { @class = "form-control", placeholder = "Ví dụ: Phụ kiện..." } })
            @Html.ValidationMessageFor(model => model.Category, "", new { @class = "text-danger", style = "color:red; font-style: italic;" })
        </div>

        <div class="form-group" style="margin-bottom: 15px;">
            <label style="font-weight: bold;">Đơn giá (VNĐ) <span style="color:red">*</span></label>
            @Html.EditorFor(model => model.Price, new { htmlAttributes = new { @class = "form-control", type = "number", min = "0" } })
            @Html.ValidationMessageFor(model => model.Price, "", new { @class = "text-danger", style = "color:red; font-style: italic;" })
        </div>

        <div class="form-group" style="margin-bottom: 25px;">
            <label style="font-weight: bold;">Số lượng khởi tạo</label>
            @Html.EditorFor(model => model.Quantity, new { htmlAttributes = new { @class = "form-control", type = "number", min = "0", @Value = "0" } })
            @Html.ValidationMessageFor(model => model.Quantity, "", new { @class = "text-danger", style = "color:red; font-style: italic;" })
        </div>

        <div class="form-group">
            <button type="submit" class="btn btn-success btn-lg">Lưu sản phẩm</button>
            @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-default btn-lg", style = "margin-left: 10px;" })
        </div>
    </div>
}