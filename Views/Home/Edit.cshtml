@model Warehouse.Models.Product
<h2>Sửa sản phẩm</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @* Giữ lại ID ẩn để biết đang sửa sản phẩm nào *@
        @Html.HiddenFor(model => model.ProductID)

        <div class="form-group">
            <label class="control-label col-md-2">Tên sản phẩm</label>
            <div class="col-md-10">
                @Html.EditorFor(model => model.ProductName, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.ProductName, "", new { @class = "text-danger", style = "color:red;" })
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2">Danh mục</label>
            <div class="col-md-10">
                @Html.EditorFor(model => model.Category, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Category, "", new { @class = "text-danger", style = "color:red;" })
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2">Đơn giá (> 0)</label>
            <div class="col-md-10">
                @Html.EditorFor(model => model.Price, new { htmlAttributes = new { @class = "form-control", type = "number" } })
                @Html.ValidationMessageFor(model => model.Price, "", new { @class = "text-danger", style = "color:red;" })
            </div>
        </div>

        @* Hiển thị Số lượng nhưng không cho sửa (readonly) *@
        <div class="form-group">
            <label class="control-label col-md-2">Số lượng (Không được sửa)</label>
            <div class="col-md-10">
                <input class="form-control" value="@Model.Quantity" readonly style="background-color: #eee;" />
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10" style="margin-top: 15px;">
                <input type="submit" value="Lưu thay đổi" class="btn btn-success" />
                @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-default" })
            </div>
        </div>
    </div>
}